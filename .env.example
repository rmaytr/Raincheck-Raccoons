# No environment variables or cloud credentials are required to play locally.
# These optional test overrides are public configuration, not secrets.
# Export them in your shell; the standalone test scripts do not load this file.
BASE_URL=http://127.0.0.1:5173
# BROWSER_EXECUTABLE=/absolute/path/to/an/existing/chromium
# TEST_OUTPUT_DIR=./test-results/browser

# Optional build-time sharing metadata URL; build:workers sets this automatically.
# NEXT_PUBLIC_SITE_URL=https://your-worker.your-account.workers.dev

# Native Next.js / Vercel server settings (never NEXT_PUBLIC-prefixed):
# RAINCHECK_BACKEND_URL=https://your-worker.your-account.workers.dev
# RAINCHECK_PROXY_SECRET=replace-with-a-random-private-key-of-at-least-32-characters
# Use the same secret as a Cloudflare Worker secret. Never commit the real value.
